+void ClearPrivacyBitmap()
+{
+	if (g_privacy_bitmap)
+	{
+		DeleteObject(g_privacy_bitmap);
+		g_privacy_bitmap = nullptr;
+	}
+}
+
+HBITMAP LoadPrivacyBitmap()
+{
+	PWSTR localAppData = nullptr;
+	// The broker runs as the signed-in user but can inherit the service's environment.
+	const HRESULT result = SHGetKnownFolderPath(FOLDERID_LocalAppData, 0, nullptr, &localAppData);
+	if (FAILED(result) || !localAppData)
+	{
+		CoTaskMemFree(localAppData);
+		return nullptr;
+	}
+	const std::wstring path = std::wstring(localAppData) + L"\\RustDesk\\privacy-mode-1-mask.bmp";
+	CoTaskMemFree(localAppData);
+	return static_cast<HBITMAP>(LoadImageW(nullptr, path.c_str(), IMAGE_BITMAP, 0, 0,
+		LR_LOADFROMFILE | LR_CREATEDIBSECTION));
+}
+
